# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# Replace with your Neon/Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Security (Generated)
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# External APIs (Rotate these immediately!)
GROQ_API_KEY=
FIRECRAWL_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=expectedestate.com
MAILGUN_BASE_URL=https://api.mailgun.net
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_monthly_placeholder
STRIPE_EXTRA_SEAT_PRICE_ID=price_extra_placeholder

# Stripe Publishable Key (Frontend — VITE_ prefix required for Vite to expose to browser)
# Find at: https://dashboard.stripe.com/apikeys → Publishable key
# Use pk_live_... for production, pk_test_... for testing
VITE_STRIPE_PUBLISHABLE_KEY=

# App Configuration
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Support
SUPPORT_EMAIL=support@example.com
