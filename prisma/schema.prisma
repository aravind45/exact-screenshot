datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  fullName      String?  @map("full_name")
  passwordHash  String?  @map("password_hash")
  role          String? // 'EXECUTOR', 'ATTORNEY', 'ADMIN'
  state         String?
  personalEmail String?  @map("personal_email")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  estates     Estate[]
  grants      EstateGrant[]
  invitations Invitation[] // Invitations sent by this user

  communications  AssetCommunication[]
  documents       Document[]
  estateDocuments EstateDocument[]

  // New Communication Log relations
  createdCommunications   Communication[]           @relation("CommunicationCreator")
  completedCommunications Communication[]           @relation("CommunicationCompletedBy")
  uploadedAttachments     CommunicationAttachment[]
  settlementActivities    SettlementActivity[]

  @@map("profiles")
}

model Estate {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  name                String
  deceasedFirstName   String    @map("deceased_first_name")
  deceasedLastName    String    @map("deceased_last_name")
  deceasedSsn         String?   @map("deceased_ssn")
  deceasedDateOfBirth DateTime? @map("deceased_date_of_birth")
  deceasedDateOfDeath DateTime  @map("deceased_date_of_death")
  deceasedState       String    @map("deceased_state")
  estateType          String?   @map("estate_type")

  // Authority Tracking
  authorityType          String    @default("UNSET") @map("authority_type") // 'PROBATE', 'SMALL_ESTATE', 'TRUST', 'UNSET'
  authorityStatus        String    @default("NOT_STARTED") @map("authority_status") // 'NOT_STARTED', 'IN_PROGRESS', 'GRANTED', 'EXPIRED'
  certifiedCopies        Int       @default(0) @map("certified_copies")
  authorityEffectiveDate DateTime? @map("authority_effective_date")

  // DE-150 Letters Info
  iaeaType      String?   @map("iaea_type") // 'FULL', 'LIMITED'
  appointedDate DateTime? @map("appointed_date")

  // Probate Tracking
  probateStatus   String  @default("NOT_STARTED") @map("probate_status") // 'NOT_REQUIRED', 'NOT_STARTED', 'FILED', 'EXECUTOR_APPOINTED', 'CLOSED'
  courtCaseNumber String? @map("court_case_number")
  probateCounty   String? @map("probate_county")

  status String? // 'INITIATION', 'DISCOVERY', 'SETTLEMENT', etc.

  inboundEmail String? @unique @map("inbound_email")
  handle       String? @unique @map("handle") // short unique id for cleaner emails

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Petitioner Info
  petitionerPhone      String? @map("petitioner_phone")
  petitionerIsAttorney Boolean @default(false) @map("petitioner_is_attorney")

  // Will Info
  hasWill      Boolean   @default(false) @map("has_will")
  willDate     DateTime? @map("will_date")
  codicilDates String[]  @map("codicil_dates")

  // Financials
  estimatedPersonalProperty Decimal? @map("est_personal_property") @db.Decimal(12, 2)
  estimatedRealProperty     Decimal? @map("est_real_property") @db.Decimal(12, 2)
  estimatedAnnualIncome     Decimal? @map("est_annual_income") @db.Decimal(12, 2)

  bondAmount Decimal? @map("bond_amount") @db.Decimal(12, 2)
  bondWaived Boolean  @default(false) @map("bond_waived")

  probateNotes String? @map("probate_notes")

  heirs Heir[]

  roadmapProgress Json? @map("roadmap_progress") // { completedTaskIds: string[], completedPhases: string[] }

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants          EstateGrant[]
  invitations     Invitation[]
  assets          Asset[]
  estateDocuments EstateDocument[]
  communications  Communication[]
  deadlines       Deadline[]
  activities      SettlementActivity[]
  liabilities     Liability[]
  distributions   Distribution[]

  @@map("estates")
}

model EstateGrant {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  userId      String   @map("user_id")
  role        String // 'OWNER', 'CO_EXECUTOR', 'ATTORNEY', 'VIEWER'
  permissions Json? // Fine-grained permissions if needed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId])
  @@map("estate_grants")
}

model Invitation {
  id         String    @id @default(uuid())
  estateId   String    @map("estate_id")
  email      String
  token      String    @unique
  role       String    @default("VIEWER") // 'CO_EXECUTOR', 'ATTORNEY', 'VIEWER'
  status     String    @default("PENDING") // 'PENDING', 'ACCEPTED', 'EXPIRED', 'REVOKED'
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  estate  Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  inviter User   @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("estate_invitations")
}

model Deadline {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  title       String
  dueDate     DateTime @map("due_date")
  status      String   @default("PENDING") // PENDING, COMPLETED, OVERDUE
  isStatutory Boolean  @default(false) @map("is_statutory")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("deadlines")
}

model Asset {
  id       String @id @default(uuid())
  estateId String @map("estate_id")
  userId   String @map("user_id") // Redundant but good for RLS/Query ease

  institution      String
  assetType        String    @map("asset_type") // 'checking', '401k'
  category         String // 'financial', 'retirement'
  ownershipType    String    @default("INDIVIDUAL") @map("ownership_type") // 'BENEFICIARY', 'JOINT', 'TRUST', 'INDIVIDUAL'
  accountNumber    String?   @map("account_number")
  value            Float?
  dateOfDeathValue Float?    @map("date_of_death_value")
  settledValue     Float?    @map("settled_value")
  settledAt        DateTime? @map("settled_at")

  status   String? // 'DISCOVERED', 'CONTACTED'
  priority String? // 'low', 'medium', 'high', 'urgent'

  lastContactDate  DateTime? @map("last_contact_date")
  nextFollowUpDate DateTime? @map("next_follow_up_date")

  institutionPhone   String? @map("institution_phone")
  institutionEmail   String? @map("institution_email")
  institutionFax     String? @map("institution_fax")
  institutionUrl     String? @map("institution_url")
  institutionAddress String? @map("institution_address")
  contactPerson      String? @map("contact_person")
  notes              String?

  workflowState Json? @map("workflow_state") // Stores { currentStep, completedSteps[], lastUpdated }

  // DE-160 Inventory Fields
  inventoryValue    Decimal? @map("inventory_value") @db.Decimal(12, 2) // Date of Death Value
  inventoryNote     String?  @map("inventory_note")
  inventoryCategory String?  @map("inventory_category") // 'ATTACHMENT_1' (Real) or 'ATTACHMENT_2' (Personal)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estate            Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  communications    AssetCommunication[]
  documents         Document[]
  newCommunications Communication[]      @relation("CommunicationToAsset")
  distributions     Distribution[]

  @@map("assets")
}

// Legacy communication model - to be deprecated
model AssetCommunication {
  id      String @id @default(uuid())
  assetId String @map("asset_id")
  userId  String @map("user_id")

  communicationDate DateTime @map("communication_date")
  type              String   @map("communication_type") // 'initial_contact', 'follow_up'
  method            String // 'email', 'phone', 'fax'
  direction         String // 'inbound', 'outbound'

  subject String
  content String?

  response     String?
  responseDate DateTime? @map("response_date")

  nextActionDate DateTime? @map("next_action_date")
  nextActionType String?   @map("next_action_type")
  contactPerson  String?   @map("contact_person")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("asset_communications")
}

// New Communication Log model (spec-compliant)
model Communication {
  id                      String    @id @default(uuid())
  estateId                String    @map("estate_id")
  assetId                 String    @map("asset_id")
  type                    String    @db.VarChar(20) // 'call', 'email', 'letter', 'fax', 'in-person'
  direction               String    @db.VarChar(10) // 'inbound', 'outbound'
  occurredAt              DateTime  @map("occurred_at") @db.Timestamptz(6)
  institutionName         String?   @map("institution_name") @db.VarChar(255)
  contactName             String?   @map("contact_name") @db.VarChar(255)
  contactChannel          String?   @map("contact_channel") @db.VarChar(255) // Email or phone
  subject                 String?   @db.VarChar(500)
  notes                   String    @db.Text
  followUpDueAt           DateTime? @map("follow_up_due_at") @db.Timestamptz(6)
  followUpCompletedAt     DateTime? @map("follow_up_completed_at") @db.Timestamptz(6)
  followUpCompletedBy     String?   @map("follow_up_completed_by")
  statusChange            String?   @map("status_change") @db.VarChar(50)
  statusChangeEffectiveAt DateTime? @map("status_change_effective_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy               String    @map("created_by")

  estate      Estate                    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  asset       Asset                     @relation("CommunicationToAsset", fields: [assetId], references: [id], onDelete: Cascade)
  creator     User                      @relation("CommunicationCreator", fields: [createdBy], references: [id])
  completedBy User?                     @relation("CommunicationCompletedBy", fields: [followUpCompletedBy], references: [id])
  attachments CommunicationAttachment[]

  @@index([estateId], name: "idx_communications_estate_id")
  @@index([assetId], name: "idx_communications_asset_id")
  @@index([occurredAt(sort: Desc)], name: "idx_communications_occurred_at")
  @@index([followUpDueAt], name: "idx_communications_follow_up")
  @@index([estateId, occurredAt(sort: Desc)], name: "idx_communications_estate_occurred")
  @@index([assetId, occurredAt(sort: Desc)], name: "idx_communications_asset_occurred")
  @@map("communications")
}

model CommunicationAttachment {
  id              String   @id @default(uuid())
  communicationId String   @map("communication_id")
  storageKey      String   @map("storage_key") @db.VarChar(500)
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  uploadedBy      String   @map("uploaded_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  uploader      User          @relation(fields: [uploadedBy], references: [id])

  @@index([communicationId], name: "idx_communication_attachments_communication_id")
  @@map("communication_attachments")
}

model Document {
  id      String @id @default(uuid())
  assetId String @map("asset_id")
  userId  String @map("user_id")

  name       String
  type       String // 'DEATH_CERTIFICATE', 'CLAIM_FORM', 'OTHER'
  fileUrl    String? @map("file_url") // Null if not yet uploaded (just a placeholder requirement)
  status     String // 'MISSING', 'UPLOADED', 'VERIFIED'
  isRequired Boolean @default(false) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("documents")
}

model Institution {
  id   String @id @default(uuid())
  name String @unique

  phone   String?
  email   String?
  fax     String?
  website String?
  address String?
  logoUrl String? @map("logo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("institutions")
}

model EstateDocument {
  id       String @id @default(uuid())
  estateId String @map("estate_id")
  userId   String @map("user_id")

  // Document Classification
  documentType String @map("document_type") // 'DEATH_CERTIFICATE', 'LETTERS_TESTAMENTARY', 'SMALL_ESTATE_AFFIDAVIT', 'EIN_LETTER', 'TRUST_CERTIFICATION', 'WILL'

  // File Storage
  name    String
  fileUrl String? @map("file_url")
  content Bytes?  @map("content")

  // Quantity Tracking (for physical documents)
  totalCopies     Int @default(0) @map("total_copies") // Total certified copies obtained
  copiesUsed      Int @default(0) @map("copies_used") // How many have been sent to institutions
  copiesRemaining Int @default(0) @map("copies_remaining") // Calculated: total - used

  // Status Tracking
  status         String    @default("NOT_STARTED") @map("status") // 'NOT_STARTED', 'PENDING', 'OBTAINED', 'EXPIRED'
  obtainedDate   DateTime? @map("obtained_date")
  expirationDate DateTime? @map("expiration_date")

  // Metadata
  issuingAuthority String? @map("issuing_authority") // e.g., "Los Angeles County Superior Court"
  referenceNumber  String? @map("reference_number") // e.g., Court Case Number for Letters
  notes            String?
  clues            Json? // Discovery clues found in this document

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([estateId, documentType])
  @@map("estate_documents")
}

model Heir {
  id           String  @id @default(uuid())
  estateId     String  @map("estate_id")
  name         String
  relationship String
  isAdult      Boolean @default(true) @map("is_adult")
  address      String?
  email        String?
  phone        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estate        Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  distributions Distribution[]

  @@map("heirs")
}

model Distribution {
  id       String @id @default(uuid())
  estateId String @map("estate_id")
  heirId   String @map("heir_id")

  assetId     String?  @map("asset_id") // Optional link to specific asset
  description String? // "100 shares of Apple", "All residue", "$50,000 cash"
  amount      Decimal? @db.Decimal(12, 2) // Estimated value distributed
  percentage  Float? // If percentage based (e.g. 50% of residue)

  isPreliminary Boolean @default(false) @map("is_preliminary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  heir   Heir   @relation(fields: [heirId], references: [id])
  asset  Asset? @relation(fields: [assetId], references: [id])

  @@map("distributions")
}

model FormTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("form_templates")
}

model SettlementActivity {
  id         String   @id @default(uuid())
  estateId   String   @map("estate_id")
  taskId     String?  @map("task_id")
  phase      String?
  type       String   @default("ROADMAP") // 'ROADMAP', 'DOCUMENT', 'ASSET', 'COMMUNICATION'
  action     String // 'COMPLETED', 'UNCOMPLETED', 'PHASE_COMPLETED', 'UPLOADED', 'UPDATED', 'CREATED'
  notes      String?
  occurredAt DateTime @default(now()) @map("occurred_at")
  userId     String   @map("user_id")

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("settlement_activities")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Liability {
  id       String @id @default(uuid())
  estateId String @map("estate_id")

  name   String // Creditor Name
  amount Decimal @db.Decimal(12, 2)
  status String  @default("DISCOVERED") // DISCOVERED, NOTICE_SENT, CLAIM_FILED, APPROVED, REJECTED, PAID, DISPUTED

  // Claims Workflow
  dateClaimFiled  DateTime? @map("date_claim_filed")
  rejectionReason String?   @map("rejection_reason")
  allowedAmount   Decimal?  @map("allowed_amount") @db.Decimal(12, 2)

  invoiceDate DateTime? @map("invoice_date")
  dueDate     DateTime? @map("due_date")

  accountNumber String? @map("account_number")
  notes         String?

  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  priority      String @default("MEDIUM") // HIGH, MEDIUM, LOW (User preference)
  priorityClass String @default("GENERAL_DEBTS") @map("priority_class") // Legal classification (e.g. FUNERAL_EXPENSES)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("liabilities")
}
