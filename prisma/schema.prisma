generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  fullName                String?                   @map("full_name")
  passwordHash            String?                   @map("password_hash")
  role                    UserRole                  @default(EXECUTOR)
  userType                String                    @default("EXECUTOR") @map("user_type") // Legacy: to be deprecated
  state                   String?
  personalEmail           String?                   @map("personal_email")
  resetPasswordToken      String?                   @map("reset_password_token")
  resetPasswordExpires    DateTime?                 @map("reset_password_expires")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  address                 String?
  city                    String?
  zip                     String?
  country                 String?
  phoneNumber             String?                   @map("phone_number")
  lastIp                  String?                   @map("last_ip")
  lastLoginAt             DateTime?                 @map("last_login_at")
  stripeCustomerId        String?                   @map("stripe_customer_id")
  stripeSubscriptionId    String?                   @map("stripe_subscription_id")
  subscriptionStatus      String?                   @default("FREE") @map("subscription_status")
  trialStartedAt          DateTime?                 @default(now()) @map("trial_started_at")
  agentExecutions         AgentExecution[]
  communications          AssetCommunication[]
  uploadedAttachments     CommunicationAttachment[]
  createdCommunications   Communication[]           @relation("CommunicationCreator")
  completedCommunications Communication[]           @relation("CommunicationCompletedBy")
  documents               Document[]
  estateDocuments         EstateDocument[]
  grants                  EstateGrant[]
  invitations             Invitation[]
  estates                 Estate[]
  heirs                   Heir[]
  settlementActivities    SettlementActivity[]
  transactions            Transaction[]
  advisorProfile          AdvisorProfile?
  bookings                Booking[]
  reviews                 Review[]

  @@map("profiles")
}

model Estate {
  id                        String               @id @default(uuid())
  userId                    String               @map("user_id")
  name                      String
  deceasedFirstName         String               @map("deceased_first_name")
  deceasedLastName          String               @map("deceased_last_name")
  deceasedSsn               String?              @map("deceased_ssn")
  deceasedDateOfBirth       DateTime?            @map("deceased_date_of_birth")
  deceasedDateOfDeath       DateTime             @map("deceased_date_of_death")
  deceasedState             String               @map("deceased_state")
  estateType                String?              @map("estate_type")
  authorityType             String               @default("UNSET") @map("authority_type")
  authorityStatus           String               @default("NOT_STARTED") @map("authority_status")
  certifiedCopies           Int                  @default(0) @map("certified_copies")
  authorityEffectiveDate    DateTime?            @map("authority_effective_date")
  iaeaType                  String?              @map("iaea_type")
  appointedDate             DateTime?            @map("appointed_date")
  hearingDate               DateTime?            @map("hearing_date")
  hearingTime               String?              @map("hearing_time")
  hearingDept               String?              @map("hearing_dept")
  hearingAddress            String?              @map("hearing_address")
  probateStatus             String               @default("NOT_STARTED") @map("probate_status")
  courtCaseNumber           String?              @map("court_case_number")
  probateCounty             String?              @map("probate_county")
  status                    String?
  inboundEmail              String?              @unique @map("inbound_email")
  handle                    String?              @unique @map("handle")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  petitionerPhone           String?              @map("petitioner_phone")
  petitionerIsAttorney      Boolean              @default(false) @map("petitioner_is_attorney")
  hasWill                   Boolean              @default(false) @map("has_will")
  willDate                  DateTime?            @map("will_date")
  codicilDates              String[]             @map("codicil_dates")
  estimatedPersonalProperty Decimal?             @map("est_personal_property") @db.Decimal(12, 2)
  estimatedRealProperty     Decimal?             @map("est_real_property") @db.Decimal(12, 2)
  estimatedAnnualIncome     Decimal?             @map("est_annual_income") @db.Decimal(12, 2)
  bondAmount                Decimal?             @map("bond_amount") @db.Decimal(12, 2)
  bondWaived                Boolean              @default(false) @map("bond_waived")
  settlementPath            String?              @map("settlement_path")
  probateNotes              String?              @map("probate_notes")
  isInternational           Boolean              @default(false) @map("is_international")
  internationalReasons      String[]             @map("international_reasons")
  roadmapProgress           Json?                @map("roadmap_progress")
  authorityDecision         Json?                @map("authority_decision")
  hasMinorBeneficiaries     Boolean              @default(false) @map("has_minor_beneficiaries")
  hasContest                Boolean              @default(false) @map("has_contest")
  hasPrimaryResidence       Boolean              @default(false) @map("has_primary_residence")
  bondWaiverStatus          String               @default("NOT_STARTED") @map("bond_waiver_status")
  guardianAdLitemId         String?              @map("guardian_ad_litem_id")
  guardianAdLitemStatus     String?              @map("guardian_ad_litem_status")
  specialNoticeParties      Json?                @map("special_notice_parties")
  estimatedLiabilities      Decimal?             @map("estimated_liabilities") @db.Decimal(12, 2)
  hasOutOfStateProperty     Boolean              @default(false) @map("has_out_of_state_property")
  hasTODDeed                Boolean              @default(false) @map("has_tod_deed")
  hasUnknownHeirs           Boolean              @default(false) @map("has_unknown_heirs")
  isOutOfState              Boolean              @default(false) @map("is_out_of_state")
  isSurvivingSpouse         Boolean              @default(false) @map("is_surviving_spouse")
  isTrustRevocable          Boolean?             @map("is_trust_revocable")
  assets                    Asset[]
  authorityDecisions        AuthorityDecision[]
  communications            Communication[]
  deadlines                 Deadline[]
  discoveryCategories       DiscoveryCategory[]
  distributions             Distribution[]
  estateDocuments           EstateDocument[]
  grants                    EstateGrant[]
  invitations               Invitation[]
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  heirs                     Heir[]
  liabilities               Liability[]
  activities                SettlementActivity[]
  taskCompletions           TaskCompletion[]
  bookings                  Booking[]

  @@map("estates")
}

model AuthorityDecision {
  id           String   @id @default(uuid())
  estateId     String   @map("estate_id")
  inputs       Json
  decision     Json
  ruleVersion  String   @map("rule_version")
  recalcReason String?  @map("recalc_reason")
  createdAt    DateTime @default(now()) @map("created_at")
  estate       Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@map("authority_decisions")
}

model EstateGrant {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  userId      String   @map("user_id")
  role        String
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  estate      Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId])
  @@map("estate_grants")
}

model Invitation {
  id         String    @id @default(uuid())
  estateId   String    @map("estate_id")
  email      String
  token      String    @unique
  role       String    @default("VIEWER")
  status     String    @default("PENDING")
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")
  paymentId  String?   @map("payment_id")
  cost       Decimal?  @db.Decimal(10, 2)
  estate     Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  inviter    User      @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("estate_invitations")
}

model Deadline {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  title       String
  dueDate     DateTime @map("due_date")
  status      String   @default("PENDING")
  isStatutory Boolean  @default(false) @map("is_statutory")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  estate      Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("deadlines")
}

model Asset {
  id                     String               @id @default(uuid())
  estateId               String               @map("estate_id")
  userId                 String               @map("user_id")
  institution            String
  assetType              String               @map("asset_type")
  category               String
  ownershipType          String               @default("INDIVIDUAL") @map("ownership_type")
  accountNumber          String?              @map("account_number")
  value                  Float?
  dateOfDeathValue       Float?               @map("date_of_death_value")
  settledValue           Float?               @map("settled_value")
  settledAt              DateTime?            @map("settled_at")
  status                 String?
  priority               String?
  lastContactDate        DateTime?            @map("last_contact_date")
  nextFollowUpDate       DateTime?            @map("next_follow_up_date")
  institutionPhone       String?              @map("institution_phone")
  institutionEmail       String?              @map("institution_email")
  institutionFax         String?              @map("institution_fax")
  institutionUrl         String?              @map("institution_url")
  institutionAddress     String?              @map("institution_address")
  contactPerson          String?              @map("contact_person")
  notes                  String?
  workflowState          Json?                @map("workflow_state")
  inventoryValue         Decimal?             @map("inventory_value") @db.Decimal(12, 2)
  inventoryNote          String?              @map("inventory_note")
  inventoryCategory      String?              @map("inventory_category")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  beneficiaryDesignation String?              @map("beneficiary_designation")
  inTrust                Boolean              @default(false) @map("in_trust")
  todDeedRecorded        Boolean              @default(false) @map("tod_deed_recorded")
  authorityType          String?              @map("authority_type")
  communications         AssetCommunication[]
  estate                 Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  newCommunications      Communication[]      @relation("CommunicationToAsset")
  distributions          Distribution[]
  documents              Document[]

  @@map("assets")
}

model AssetCommunication {
  id                String    @id @default(uuid())
  assetId           String    @map("asset_id")
  userId            String    @map("user_id")
  communicationDate DateTime  @map("communication_date")
  type              String    @map("communication_type")
  method            String
  direction         String
  subject           String
  content           String?
  response          String?
  responseDate      DateTime? @map("response_date")
  nextActionDate    DateTime? @map("next_action_date")
  nextActionType    String?   @map("next_action_type")
  contactPerson     String?   @map("contact_person")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id])

  @@map("asset_communications")
}

model Communication {
  id                      String                    @id @default(uuid())
  estateId                String                    @map("estate_id")
  assetId                 String                    @map("asset_id")
  type                    String                    @db.VarChar(20)
  direction               String                    @db.VarChar(10)
  occurredAt              DateTime                  @map("occurred_at") @db.Timestamptz(6)
  institutionName         String?                   @map("institution_name") @db.VarChar(255)
  contactName             String?                   @map("contact_name") @db.VarChar(255)
  contactChannel          String?                   @map("contact_channel") @db.VarChar(255)
  subject                 String?                   @db.VarChar(500)
  notes                   String
  followUpDueAt           DateTime?                 @map("follow_up_due_at") @db.Timestamptz(6)
  followUpCompletedAt     DateTime?                 @map("follow_up_completed_at") @db.Timestamptz(6)
  followUpCompletedBy     String?                   @map("follow_up_completed_by")
  statusChange            String?                   @map("status_change") @db.VarChar(50)
  statusChangeEffectiveAt DateTime?                 @map("status_change_effective_at") @db.Timestamptz(6)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy               String                    @map("created_by")
  attachments             CommunicationAttachment[]
  asset                   Asset                     @relation("CommunicationToAsset", fields: [assetId], references: [id], onDelete: Cascade)
  creator                 User                      @relation("CommunicationCreator", fields: [createdBy], references: [id])
  estate                  Estate                    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  completedBy             User?                     @relation("CommunicationCompletedBy", fields: [followUpCompletedBy], references: [id])

  @@index([estateId], map: "idx_communications_estate_id")
  @@index([assetId], map: "idx_communications_asset_id")
  @@index([occurredAt(sort: Desc)], map: "idx_communications_occurred_at")
  @@index([followUpDueAt], map: "idx_communications_follow_up")
  @@index([estateId, occurredAt(sort: Desc)], map: "idx_communications_estate_occurred")
  @@index([assetId, occurredAt(sort: Desc)], map: "idx_communications_asset_occurred")
  @@map("communications")
}

model CommunicationAttachment {
  id              String        @id @default(uuid())
  communicationId String        @map("communication_id")
  storageKey      String        @map("storage_key") @db.VarChar(500)
  fileName        String        @map("file_name") @db.VarChar(255)
  mimeType        String        @map("mime_type") @db.VarChar(100)
  sizeBytes       Int           @map("size_bytes")
  uploadedBy      String        @map("uploaded_by")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  uploader        User          @relation(fields: [uploadedBy], references: [id])

  @@index([communicationId], map: "idx_communication_attachments_communication_id")
  @@map("communication_attachments")
}

model Document {
  id         String   @id @default(uuid())
  assetId    String   @map("asset_id")
  userId     String   @map("user_id")
  name       String
  type       String
  fileUrl    String?  @map("file_url")
  status     String
  isRequired Boolean  @default(false) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@map("documents")
}

model Institution {
  id        String   @id @default(uuid())
  name      String   @unique
  phone     String?
  email     String?
  fax       String?
  website   String?
  address   String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("institutions")
}

model EstateDocument {
  id               String    @id @default(uuid())
  estateId         String    @map("estate_id")
  userId           String    @map("user_id")
  documentType     String    @map("document_type")
  name             String
  fileUrl          String?   @map("file_url")
  content          Bytes?    @map("content")
  totalCopies      Int       @default(0) @map("total_copies")
  copiesUsed       Int       @default(0) @map("copies_used")
  copiesRemaining  Int       @default(0) @map("copies_remaining")
  status           String    @default("NOT_STARTED") @map("status")
  obtainedDate     DateTime? @map("obtained_date")
  expirationDate   DateTime? @map("expiration_date")
  issuingAuthority String?   @map("issuing_authority")
  referenceNumber  String?   @map("reference_number")
  notes            String?
  clues            Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  estate           Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id])

  @@index([estateId, documentType])
  @@map("estate_documents")
}

model Heir {
  id            String         @id @default(uuid())
  estateId      String         @map("estate_id")
  name          String
  relationship  String
  isAdult       Boolean        @default(true) @map("is_adult")
  address       String?
  email         String?
  phone         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  userId        String?        @map("user_id")
  distributions Distribution[]
  estate        Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])

  @@map("heirs")
}

model Distribution {
  id            String   @id @default(uuid())
  estateId      String   @map("estate_id")
  heirId        String   @map("heir_id")
  assetId       String?  @map("asset_id")
  description   String?
  amount        Decimal? @db.Decimal(12, 2)
  percentage    Float?
  isPreliminary Boolean  @default(false) @map("is_preliminary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  asset         Asset?   @relation(fields: [assetId], references: [id])
  estate        Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  heir          Heir     @relation(fields: [heirId], references: [id])

  @@map("distributions")
}

model FormTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  title       String?
  description String?
  icon        String?  @default("FileText")
  state       String   @default("CA")
  category    String   @default("General")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("form_templates")
}

model SettlementActivity {
  id           String   @id @default(uuid())
  estateId     String   @map("estate_id")
  taskId       String?  @map("task_id")
  phase        String?
  type         String   @default("ROADMAP")
  action       String
  notes        String?
  occurredAt   DateTime @default(now()) @map("occurred_at")
  userId       String   @map("user_id")
  hash         String?
  previousHash String?  @map("previous_hash")
  estate       Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

  @@index([estateId, occurredAt])
  @@map("settlement_activities")
}

model AppSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Liability {
  id              String    @id @default(uuid())
  estateId        String    @map("estate_id")
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("DISCOVERED")
  dateClaimFiled  DateTime? @map("date_claim_filed")
  rejectionReason String?   @map("rejection_reason")
  allowedAmount   Decimal?  @map("allowed_amount") @db.Decimal(12, 2)
  invoiceDate     DateTime? @map("invoice_date")
  dueDate         DateTime? @map("due_date")
  accountNumber   String?   @map("account_number")
  notes           String?
  contactPhone    String?   @map("contact_phone")
  contactEmail    String?   @map("contact_email")
  priority        String    @default("MEDIUM")
  priorityClass   String    @default("GENERAL_DEBTS") @map("priority_class")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  estate          Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("liabilities")
}

model DiscoveryCategory {
  id               String              @id @default(uuid())
  estateId         String              @map("estate_id")
  category         String
  status           String              @default("NOT_CHECKED")
  evidenceSource   String?             @map("evidence_source")
  reviewDate       DateTime?           @map("review_date")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  estate           Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  negativeFindings NegativeAssurance[]

  @@unique([estateId, category])
  @@map("discovery_categories")
}

model NegativeAssurance {
  id                  String            @id @default(uuid())
  discoveryCategoryId String            @map("discovery_category_id")
  statement           String
  createdAt           DateTime          @default(now()) @map("created_at")
  category            DiscoveryCategory @relation(fields: [discoveryCategoryId], references: [id], onDelete: Cascade)

  @@map("negative_assurance_logs")
}

model TaskCompletion {
  id          String    @id @default(uuid())
  estateId    String    @map("estate_id")
  taskId      String    @map("task_id")
  phase       String?
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")
  notes       String?
  attachments String[]
  estate      Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([estateId, taskId])
  @@map("task_completions")
}

model SettlementType {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  description String?
  tier        Int            @default(1)
  coverage    Float          @default(0)
  isActive    Boolean        @default(true) @map("is_active")
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  phases      RoadmapPhase[]

  @@map("settlement_types")
}

model RoadmapPhase {
  id               String         @id @default(uuid())
  settlementTypeId String         @map("settlement_type_id")
  phaseCode        String
  title            String
  subtitle         String?
  description      String?
  milestone        String?
  orderIndex       Int            @map("order_index")
  trigger          String?
  triggerLabel     String?        @map("trigger_label")
  isEscalationPath Boolean        @default(false) @map("is_escalation_path")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  settlementType   SettlementType @relation(fields: [settlementTypeId], references: [id], onDelete: Cascade)
  tasks            RoadmapTask[]

  @@unique([settlementTypeId, phaseCode])
  @@map("roadmap_phases")
}

model RoadmapTask {
  id                  String       @id @default(uuid())
  phaseId             String       @map("phase_id")
  taskCode            String
  title               String
  description         String?
  estimatedTime       String?      @map("estimated_time")
  category            String?
  orderIndex          Int          @map("order_index")
  isOptional          Boolean      @default(false) @map("is_optional")
  requiresAuthority   Boolean      @default(false) @map("requires_authority")
  requiredDocs        String[]     @map("required_docs")
  dependencies        String[]
  exclusiveGroup      String?      @map("exclusive_group")
  trackCompatibility  String[]     @map("track_compatibility")
  riskWarning         String?      @map("risk_warning")
  deadlineWarningId   String?      @map("deadline_warning_id")
  isInternationalOnly Boolean      @default(false) @map("is_international_only")
  alerts              Json?
  links               Json?
  tags                String[]
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  phase               RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, taskCode])
  @@map("roadmap_tasks")
}

model Transaction {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("USD")
  status                String   @default("SUCCESS")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  type                  String   @default("PAYMENT")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model KnowledgeChunk {
  id        String                 @id @default(uuid())
  content   String
  metadata  Json?
  embedding Unsupported("vector")?
  source    String?
  createdAt DateTime               @default(now()) @map("created_at")

  @@map("knowledge_chunks")
  @@ignore // Deprecated: Use Document/Chunk/ChunkEmbedding
}

enum DocType {
  STATUTE
  POLICY
  PLAYBOOK
  FAQ
  FORM
  BLOG
  OTHER
}

model RagDocument {
  id            String   @id @default(uuid())
  sourceUri     String?
  title         String
  docType       DocType  @default(OTHER)
  jurisdiction  String?
  effectiveDate DateTime?
  version       String?
  ingestedAt    DateTime @default(now())
  securityTags  String[] @default([])

  chunks        RagChunk[]

  @@index([jurisdiction])
  @@index([docType])
  @@index([effectiveDate])
  @@map("rag_documents")
}

model RagChunk {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  document      RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  parentId      String?  @map("parent_id")
  parent        RagChunk?   @relation("ChunkParent", fields: [parentId], references: [id])
  children      RagChunk[]  @relation("ChunkParent")

  headingPath   String?  @map("heading_path")
  sectionId     String?  @map("section_id")
  pageStart     Int?     @map("page_start")
  pageEnd       Int?     @map("page_end")

  text          String
  tokenCount    Int?     @map("token_count")
  contentHash   String   @map("content_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // tsvector column "tsv" will be added via raw SQL migration
  
  embeddings    RagChunkEmbedding[]

  @@index([documentId])
  @@index([parentId])
  @@index([sectionId])
  @@unique([documentId, contentHash])
  @@map("rag_chunks")
}

model RagChunkEmbedding {
  id          String   @id @default(uuid())
  chunkId     String   @map("chunk_id")
  chunk       RagChunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  vectorType  String   @default("content") @map("vector_type")
  modelId     String   @map("model_id")

  embedding   Unsupported("vector")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([chunkId])
  @@index([vectorType, modelId])
  @@map("rag_chunk_embeddings")
}

model AgentExecution {
  id              String   @id @default(uuid())
  executionId     String   @unique @map("execution_id")
  userId          String?  @map("user_id")
  question        String
  answer          String
  sources         String[]
  evidence        Json
  metadata        Json
  executionTimeMs Int      @map("execution_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("agent_executions")
}

model MarketingEvent {
  id          String   @id @default(uuid())
  event       String
  email       String?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("marketing_events")
}

model AdvisorProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  bio                      String?
  expertise                String[]
  hourlyRate               Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  stripeAccountId          String?  @map("stripe_account_id")
  stripeOnboardingComplete Boolean  @default(false) @map("stripe_onboarding_complete")
  stripeDetailsSubmitted   Boolean  @default(false) @map("stripe_details_submitted")
  verificationStatus       String   @default("PENDING") @map("verification_status")
  profileImage             String?  @map("profile_image")
  licenseNumber            String?  @map("license_number")
  licenseDocument          String?  @map("license_document")
  isVerified               Boolean  @default(false) @map("is_verified")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings                 Booking[]
  reviews                  Review[]

  @@map("advisor_profiles")
}

model Booking {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  advisorId          String    @map("advisor_id")
  estateId           String?   @map("estate_id")
  status             String    @default("PENDING")
  sessionDuration    Int?      // Hours booked
  sessionDate        DateTime? @map("session_date")
  totalAmount        Decimal   @map("total_amount") @db.Decimal(10, 2)
  platformFee        Decimal   @map("platform_fee") @db.Decimal(10, 2)
  advisorPayout      Decimal   @map("advisor_payout") @db.Decimal(10, 2)
  escrowReleaseDate  DateTime? @map("escrow_release_date")
  payoutStatus       String    @default("UNPAID") @map("payout_status")
  stripePaymentId    String?   @map("stripe_payment_id")
  cancellationReason String?   @map("cancellation_reason")
  refundAmount       Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundedAt         DateTime? @map("refunded_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id])
  advisor            AdvisorProfile @relation(fields: [advisorId], references: [id])
  estate             Estate?   @relation(fields: [estateId], references: [id])
  review             Review?

  @@index([userId])
  @@index([advisorId])
  @@index([status])
  @@map("bookings")
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique @map("booking_id")
  userId     String   @map("user_id")
  advisorId  String   @map("advisor_id")
  rating     Int      // 1-5 stars
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  user       User           @relation(fields: [userId], references: [id])
  advisor    AdvisorProfile @relation(fields: [advisorId], references: [id])
  booking    Booking        @relation(fields: [bookingId], references: [id])

  @@index([advisorId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@map("token_blacklist")
}

enum UserRole {
  ADMIN
  ADVISOR
  ATTORNEY
  EXECUTOR
  HEIR
}
