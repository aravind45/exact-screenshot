generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  fullName                String?                   @map("full_name")
  passwordHash            String?                   @map("password_hash")
  state                   String?
  personalEmail           String?                   @map("personal_email")
  resetPasswordToken      String?                   @map("reset_password_token")
  resetPasswordExpires    DateTime?                 @map("reset_password_expires")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  address                 String?
  city                    String?
  zip                     String?
  country                 String?
  phoneNumber             String?                   @map("phone_number")
  lastIp                  String?                   @map("last_ip")
  lastLoginAt             DateTime?                 @map("last_login_at")
  stripeCustomerId        String?                   @map("stripe_customer_id")
  stripeSubscriptionId    String?                   @map("stripe_subscription_id")
  subscriptionStatus      String?                   @default("FREE") @map("subscription_status")
  trialStartedAt          DateTime?                 @default(now()) @map("trial_started_at")
  userType                String                    @default("EXECUTOR") @map("user_type")
  role                    UserRole                  @default(EXECUTOR)
  emailVerifiedAt         DateTime?                 @map("email_verified_at")
  verificationToken       String?                   @map("verification_token")
  isPilot                 Boolean                   @default(false) @map("is_pilot")
  adminActionLogs         AdminActionLog[]
  advisorProfile          AdvisorProfile?
  agentExecutions         AgentExecution[]
  communications          AssetCommunication[]
  bookings                Booking[]
  uploadedAttachments     CommunicationAttachment[]
  createdCommunications   Communication[]           @relation("CommunicationCreator")
  completedCommunications Communication[]           @relation("CommunicationCompletedBy")
  documents               Document[]
  estateDocuments         EstateDocument[]
  grants                  EstateGrant[]
  invitations             Invitation[]
  estates                 Estate[]
  heirs                   Heir[]
  marketplacePayments     MarketplacePayment[]
  reviews                 Review[]
  settlementActivities    SettlementActivity[]
  transactions            Transaction[]

  @@map("profiles")
}

model Estate {
  id                        String               @id @default(uuid())
  userId                    String               @map("user_id")
  name                      String
  deceasedFirstName         String               @map("deceased_first_name")
  deceasedLastName          String               @map("deceased_last_name")
  deceasedSsn               String?              @map("deceased_ssn")
  deceasedDateOfBirth       DateTime?            @map("deceased_date_of_birth")
  deceasedDateOfDeath       DateTime?            @map("deceased_date_of_death")
  deceasedState             String               @map("deceased_state")
  estateType                String?              @map("estate_type")
  authorityType             String               @default("UNSET") @map("authority_type")
  estateAuthorityType      String?              @map("estate_authority_type")
  authorityStatus           String               @default("NOT_STARTED") @map("authority_status")
  certifiedCopies           Int                  @default(0) @map("certified_copies")
  authorityEffectiveDate    DateTime?            @map("authority_effective_date")
  iaeaType                  String?              @map("iaea_type")
  appointedDate             DateTime?            @map("appointed_date")
  hearingDate               DateTime?            @map("hearing_date")
  hearingTime               String?              @map("hearing_time")
  hearingDept               String?              @map("hearing_dept")
  hearingAddress            String?              @map("hearing_address")
  probateStatus             String               @default("NOT_STARTED") @map("probate_status")
  courtCaseNumber           String?              @map("court_case_number")
  probateCounty             String?              @map("probate_county")
  status                    String?
  inboundEmail              String?              @unique @map("inbound_email")
  handle                    String?              @unique @map("handle")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  petitionerPhone           String?              @map("petitioner_phone")
  petitionerIsAttorney      Boolean              @default(false) @map("petitioner_is_attorney")
  hasWill                   Boolean              @default(false) @map("has_will")
  willDate                  DateTime?            @map("will_date")
  codicilDates              String[]             @map("codicil_dates")
  estimatedPersonalProperty Decimal?             @map("est_personal_property") @db.Decimal(12, 2)
  estimatedRealProperty     Decimal?             @map("est_real_property") @db.Decimal(12, 2)
  estimatedAnnualIncome     Decimal?             @map("est_annual_income") @db.Decimal(12, 2)
  bondAmount                Decimal?             @map("bond_amount") @db.Decimal(12, 2)
  bondWaived                Boolean              @default(false) @map("bond_waived")
  settlementPath            String?              @map("settlement_path")
  probateNotes              String?              @map("probate_notes")
  isInternational           Boolean              @default(false) @map("is_international")
  internationalReasons      String[]             @map("international_reasons")
  roadmapProgress           Json?                @map("roadmap_progress")
  authorityDecision         Json?                @map("authority_decision")
  hasMinorBeneficiaries     Boolean              @default(false) @map("has_minor_beneficiaries")
  hasContest                Boolean              @default(false) @map("has_contest")
  hasPrimaryResidence       Boolean              @default(false) @map("has_primary_residence")
  bondWaiverStatus          String               @default("NOT_STARTED") @map("bond_waiver_status")
  guardianAdLitemId         String?              @map("guardian_ad_litem_id")
  guardianAdLitemStatus     String?              @map("guardian_ad_litem_status")
  specialNoticeParties      Json?                @map("special_notice_parties")
  estimatedLiabilities      Decimal?             @map("estimated_liabilities") @db.Decimal(12, 2)
  hasOutOfStateProperty     Boolean              @default(false) @map("has_out_of_state_property")
  hasTODDeed                Boolean              @default(false) @map("has_tod_deed")
  hasUnknownHeirs           Boolean              @default(false) @map("has_unknown_heirs")
  isOutOfState              Boolean              @default(false) @map("is_out_of_state")
  isSurvivingSpouse         Boolean              @default(false) @map("is_surviving_spouse")
  isTrustRevocable          Boolean?             @map("is_trust_revocable")
  administrationType        String?              @map("administration_type")
  
  // Roadmap versioning for SSOT pinning
  roadmapVersion            String?              @map("roadmap_version")
  roadmapPinnedAt           DateTime?            @map("roadmap_pinned_at")
  stateRulesetHash          String?              @map("state_ruleset_hash")
  countyOverrideId          String?              @map("county_override_id")
  countyOverrideHash        String?              @map("county_override_hash")
  
  // Authority Type Change Policy
  authorityTypeSource       String?              @map("authority_type_source") // "ENGINE" | "MANUAL" | "PINNED"
  authorityPinnedAt         DateTime?            @map("authority_pinned_at")
  authorityChangePending    Boolean              @default(false) @map("authority_change_pending")
  recommendedAuthorityType  String?              @map("recommended_authority_type")
  recommendedAuthorityReason Json?               @map("recommended_authority_reason")

  // Track Selection Onboarding
  userSelectedEstateAuthorityType String?  @map("user_selected_estate_authority_type") // "PROBATE" | "TRUST" | "BOTH"
  userSelectedAuthorityAt     DateTime? @map("user_selected_authority_at")
  hasProbateAssets          Boolean?   @map("has_probate_assets") // User answer: has probate assets
  hasTrustAssets            Boolean?   @map("has_trust_assets") // User answer: has trust assets
  hasBeneficiaryAssets      Boolean?   @map("has_beneficiary_assets") // User answer: has POD/TOD/beneficiary assets
  assistedDecisionAnswers    Json?      @map("assisted_decision_answers") // Store "help me decide" question answers
  authorityConfidenceScore  Int?       @map("authority_confidence_score") // 0-100 confidence score
  authorityDeterminationSource String?   @map("authority_determination_source") // "USER_SELECTION" | "ENGINE_HIGH_CONFIDENCE" | "ENGINE_LOW_CONFIDENCE" | "DEFAULT_FAIL_CLOSED"

  assets                    Asset[]
  authorityChangeEvents     AuthorityChangeEvent[]
  authorityDecisions        AuthorityDecision[]
  bookings                  Booking[]
  communications            Communication[]
  deadlines                 Deadline[]
  discoveryCategories       DiscoveryCategory[]
  distributions             Distribution[]
  estateDocuments           EstateDocument[]
  grants                    EstateGrant[]
  invitations               Invitation[]
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  heirs                     Heir[]
  lettersDispatches         LettersDispatch[]
  liabilities               Liability[]
  mailings                  Mailing[]
  activities                SettlementActivity[]
  taskCompletions           TaskCompletion[]

  @@map("estates")
}

model AuthorityDecision {
  id           String   @id @default(uuid())
  estateId     String   @map("estate_id")
  inputs       Json
  decision     Json
  ruleVersion  String   @map("rule_version")
  recalcReason String?  @map("recalc_reason")
  createdAt    DateTime @default(now()) @map("created_at")
  estate       Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@map("authority_decisions")
}

model EstateGrant {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  userId      String   @map("user_id")
  role        String
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  estate      Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId])
  @@map("estate_grants")
}

model Invitation {
  id         String    @id @default(uuid())
  estateId   String    @map("estate_id")
  email      String
  token      String    @unique
  role       String    @default("VIEWER")
  status     String    @default("PENDING")
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")
  paymentId  String?   @map("payment_id")
  cost       Decimal?  @db.Decimal(10, 2)
  estate     Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  inviter    User      @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("estate_invitations")
}

model Deadline {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  title       String
  dueDate     DateTime @map("due_date")
  status      String   @default("PENDING")
  isStatutory Boolean  @default(false) @map("is_statutory")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  warningId   String   @default("") @map("warning_id")
  description String   @default("")
  isCompleted Boolean  @default(false) @map("is_completed")
  estate      Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("deadlines")
}

model Asset {
  id                     String               @id @default(uuid())
  estateId               String               @map("estate_id")
  userId                 String               @map("user_id")
  institution            String
  assetType              String               @map("asset_type")
  category               String
  ownershipType          String               @default("INDIVIDUAL") @map("ownership_type")
  accountNumber          String?              @map("account_number")
  value                  Float?
  dateOfDeathValue       Float?               @map("date_of_death_value")
  settledValue           Float?               @map("settled_value")
  settledAt              DateTime?            @map("settled_at")
  status                 String?
  priority               String?
  lastContactDate        DateTime?            @map("last_contact_date")
  nextFollowUpDate       DateTime?            @map("next_follow_up_date")
  institutionPhone       String?              @map("institution_phone")
  institutionEmail       String?              @map("institution_email")
  institutionFax         String?              @map("institution_fax")
  institutionUrl         String?              @map("institution_url")
  institutionAddress     String?              @map("institution_address")
  contactPerson          String?              @map("contact_person")
  notes                  String?
  workflowState          Json?                @map("workflow_state")
  inventoryValue         Decimal?             @map("inventory_value") @db.Decimal(12, 2)
  inventoryNote          String?              @map("inventory_note")
  inventoryCategory      String?              @map("inventory_category")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  beneficiaryDesignation String?              @map("beneficiary_designation")
  inTrust                Boolean              @default(false) @map("in_trust")
  todDeedRecorded        Boolean              @default(false) @map("tod_deed_recorded")
  authorityType          String?              @map("authority_type")
  communications         AssetCommunication[]
  estate                 Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  newCommunications      Communication[]      @relation("CommunicationToAsset")
  distributions          Distribution[]
  documents              Document[]

  @@map("assets")
}

model AssetCommunication {
  id                String    @id @default(uuid())
  assetId           String    @map("asset_id")
  userId            String    @map("user_id")
  communicationDate DateTime  @map("communication_date")
  type              String    @map("communication_type")
  method            String
  direction         String
  subject           String
  content           String?
  response          String?
  responseDate      DateTime? @map("response_date")
  nextActionDate    DateTime? @map("next_action_date")
  nextActionType    String?   @map("next_action_type")
  contactPerson     String?   @map("contact_person")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id])

  @@map("asset_communications")
}

model Communication {
  id                      String                    @id @default(uuid())
  estateId                String                    @map("estate_id")
  assetId                 String                    @map("asset_id")
  type                    String                    @db.VarChar(20)
  direction               String                    @db.VarChar(10)
  occurredAt              DateTime                  @map("occurred_at") @db.Timestamptz(6)
  institutionName         String?                   @map("institution_name") @db.VarChar(255)
  contactName             String?                   @map("contact_name") @db.VarChar(255)
  contactChannel          String?                   @map("contact_channel") @db.VarChar(255)
  subject                 String?                   @db.VarChar(500)
  notes                   String
  followUpDueAt           DateTime?                 @map("follow_up_due_at") @db.Timestamptz(6)
  followUpCompletedAt     DateTime?                 @map("follow_up_completed_at") @db.Timestamptz(6)
  followUpCompletedBy     String?                   @map("follow_up_completed_by")
  statusChange            String?                   @map("status_change") @db.VarChar(50)
  statusChangeEffectiveAt DateTime?                 @map("status_change_effective_at") @db.Timestamptz(6)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy               String                    @map("created_by")
  attachments             CommunicationAttachment[]
  asset                   Asset                     @relation("CommunicationToAsset", fields: [assetId], references: [id], onDelete: Cascade)
  creator                 User                      @relation("CommunicationCreator", fields: [createdBy], references: [id])
  estate                  Estate                    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  completedBy             User?                     @relation("CommunicationCompletedBy", fields: [followUpCompletedBy], references: [id])

  @@index([estateId], map: "idx_communications_estate_id")
  @@index([assetId], map: "idx_communications_asset_id")
  @@index([occurredAt(sort: Desc)], map: "idx_communications_occurred_at")
  @@index([followUpDueAt], map: "idx_communications_follow_up")
  @@index([estateId, occurredAt(sort: Desc)], map: "idx_communications_estate_occurred")
  @@index([assetId, occurredAt(sort: Desc)], map: "idx_communications_asset_occurred")
  @@map("communications")
}

model CommunicationAttachment {
  id              String        @id @default(uuid())
  communicationId String        @map("communication_id")
  storageKey      String        @map("storage_key") @db.VarChar(500)
  fileName        String        @map("file_name") @db.VarChar(255)
  mimeType        String        @map("mime_type") @db.VarChar(100)
  sizeBytes       Int           @map("size_bytes")
  uploadedBy      String        @map("uploaded_by")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  uploader        User          @relation(fields: [uploadedBy], references: [id])

  @@index([communicationId], map: "idx_communication_attachments_communication_id")
  @@map("communication_attachments")
}

model Document {
  id         String   @id @default(uuid())
  assetId    String   @map("asset_id")
  userId     String   @map("user_id")
  name       String
  type       String
  fileUrl    String?  @map("file_url")
  status     String
  isRequired Boolean  @default(false) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@map("documents")
}

model Institution {
  id        String   @id @default(uuid())
  name      String   @unique
  phone     String?
  email     String?
  fax       String?
  website   String?
  address   String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("institutions")
}

model EstateDocument {
  id               String    @id @default(uuid())
  estateId         String    @map("estate_id")
  userId           String    @map("user_id")
  documentType     String    @map("document_type")
  name             String
  fileUrl          String?   @map("file_url")
  content          Bytes?    @map("content")
  totalCopies      Int       @default(0) @map("total_copies")
  copiesUsed       Int       @default(0) @map("copies_used")
  copiesRemaining  Int       @default(0) @map("copies_remaining")
  status           String    @default("NOT_STARTED") @map("status")
  obtainedDate     DateTime? @map("obtained_date")
  expirationDate   DateTime? @map("expiration_date")
  issuingAuthority String?   @map("issuing_authority")
  referenceNumber  String?   @map("reference_number")
  notes            String?
  clues            Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  estate           Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id])

  @@index([estateId, documentType])
  @@map("estate_documents")
}

model Heir {
  id            String         @id @default(uuid())
  estateId      String         @map("estate_id")
  name          String
  relationship  String
  isAdult       Boolean        @default(true) @map("is_adult")
  address       String?
  email         String?
  phone         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  userId        String?        @map("user_id")
  distributions Distribution[]
  estate        Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])

  @@map("heirs")
}

model Distribution {
  id            String   @id @default(uuid())
  estateId      String   @map("estate_id")
  heirId        String   @map("heir_id")
  assetId       String?  @map("asset_id")
  description   String?
  amount        Decimal? @db.Decimal(12, 2)
  percentage    Float?
  isPreliminary Boolean  @default(false) @map("is_preliminary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  asset         Asset?   @relation(fields: [assetId], references: [id])
  estate        Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  heir          Heir     @relation(fields: [heirId], references: [id])

  @@map("distributions")
}

model FormTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  title       String?
  description String?
  icon        String?  @default("FileText")
  state       String   @default("CA")
  category    String   @default("General")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("form_templates")
}

model SettlementActivity {
  id           String   @id @default(uuid())
  estateId     String   @map("estate_id")
  taskId       String?  @map("task_id")
  phase        String?
  type         String   @default("ROADMAP")
  action       String
  notes        String?
  occurredAt   DateTime @default(now()) @map("occurred_at")
  userId       String   @map("user_id")
  hash         String?
  previousHash String?  @map("previous_hash")
  estate       Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

  @@index([estateId, occurredAt])
  @@map("settlement_activities")
}

model AppSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Liability {
  id              String    @id @default(uuid())
  estateId        String    @map("estate_id")
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("DISCOVERED")
  dateClaimFiled  DateTime? @map("date_claim_filed")
  rejectionReason String?   @map("rejection_reason")
  allowedAmount   Decimal?  @map("allowed_amount") @db.Decimal(12, 2)
  invoiceDate     DateTime? @map("invoice_date")
  dueDate         DateTime? @map("due_date")
  accountNumber   String?   @map("account_number")
  notes           String?
  contactPhone    String?   @map("contact_phone")
  contactEmail    String?   @map("contact_email")
  priority        String    @default("MEDIUM")
  priorityClass   String    @default("GENERAL_DEBTS") @map("priority_class")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  address         String?
  city            String?
  country         String?   @default("US")
  state           String?
  zip             String?
  estate          Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("liabilities")
}

model Mailing {
  id          String   @id @default(uuid())
  estateId    String   @map("estate_id")
  targetType  String
  targetId    String
  lobId       String   @unique @map("lob_id")
  status      String   @default("PENDING")
  trackingUrl String?  @map("tracking_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  estate      Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@map("mailings")
}

model DiscoveryCategory {
  id               String              @id @default(uuid())
  estateId         String              @map("estate_id")
  category         String
  status           String              @default("NOT_CHECKED")
  evidenceSource   String?             @map("evidence_source")
  reviewDate       DateTime?           @map("review_date")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  estate           Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  negativeFindings NegativeAssurance[]

  @@unique([estateId, category])
  @@map("discovery_categories")
}

model NegativeAssurance {
  id                  String            @id @default(uuid())
  discoveryCategoryId String            @map("discovery_category_id")
  statement           String
  createdAt           DateTime          @default(now()) @map("created_at")
  category            DiscoveryCategory @relation(fields: [discoveryCategoryId], references: [id], onDelete: Cascade)

  @@map("negative_assurance_logs")
}

model TaskCompletion {
  id          String    @id @default(uuid())
  estateId    String    @map("estate_id")
  taskId      String    @map("task_id")
  phase       String?
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")
  notes       String?
  attachments String[]
  estate      Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([estateId, taskId])
  @@map("task_completions")
}

model SettlementType {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  description String?
  tier        Int            @default(1)
  coverage    Float          @default(0)
  isActive    Boolean        @default(true) @map("is_active")
  version     Int            @default(1)
  versionTag  String?        @map("version_tag")
  isPublished Boolean        @default(false) @map("is_published")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  phases      RoadmapPhase[]

  @@map("settlement_types")
}

// SSOT Roadmap Version tracking for estate pinning
model RoadmapVersion {
  id          String   @id @default(uuid())
  version     String   // Semantic version: "1.0.0", "1.1.0", etc.
  settlementTypeCode String @map("settlement_type_code")
  isActive   Boolean  @default(true) @map("is_active")
  isPublished Boolean @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  releasedAt  DateTime @default(now()) @map("released_at")
  releasedBy  String?  @map("released_by")
  changelog   String?
  schemaHash  String?  @map("schema_hash") // Hash of tasks/phases for change detection
  
  @@unique([version, settlementTypeCode])
  @@map("roadmap_versions")
}

model RoadmapPhase {
  id               String         @id @default(uuid())
  settlementTypeId String         @map("settlement_type_id")
  phaseCode        String
  title            String
  subtitle         String?
  description      String?
  milestone        String?
  orderIndex       Int            @map("order_index")
  trigger          String?
  triggerLabel     String?        @map("trigger_label")
  isEscalationPath Boolean        @default(false) @map("is_escalation_path")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  settlementType   SettlementType @relation(fields: [settlementTypeId], references: [id], onDelete: Cascade)
  tasks            RoadmapTask[]

  @@unique([settlementTypeId, phaseCode])
  @@map("roadmap_phases")
}

model RoadmapTask {
  id                          String       @id @default(uuid())
  phaseId                     String       @map("phase_id")
  taskCode                    String
  title                       String
  description                 String?
  estimatedTime               String?      @map("estimated_time")
  category                    String?
  orderIndex                  Int          @map("order_index")
  isOptional                  Boolean      @default(false) @map("is_optional")
  requiresAuthority           Boolean      @default(false) @map("requires_authority")
  requiredDocs                String[]     @map("required_docs")
  dependencies                String[]
  exclusiveGroup              String?      @map("exclusive_group")
  trackCompatibility          String[]     @map("track_compatibility")
  riskWarning                 String?      @map("risk_warning")
  rationale                   String?      @map("rationale")
  isAttorneyReviewNode        Boolean      @default(false) @map("is_attorney_review_node")
  attorneyReviewReason        String?      @map("attorney_review_reason")
  isConditional               Boolean      @default(false) @map("is_conditional")
  conditionalRequirementLabel String?      @map("conditional_requirement_label")
  utility                     String?      @map("utility")
  requiresNotary              Boolean      @default(false) @map("requires_notary")
  requiresPhysicalMail        Boolean      @default(false) @map("requires_physical_mail")
  deadlineWarningId           String?      @map("deadline_warning_id")
  isInternationalOnly         Boolean      @default(false) @map("is_international_only")
  alerts                      Json?
  links                       Json?
  tags                        String[]
  primaryActionLabel          String?      @map("primary_action_label")
  primaryActionUrl            String?      @map("primary_action_url")
  formNames                   String[]     @map("form_names")
  applicableVariants          String[]     @map("applicable_variants")
  predicatesAll               String[]     @map("predicates_all")
  predicatesAny               String[]     @map("predicates_any")
  excludePredicates           String[]     @map("exclude_predicates")
  requiredProfileFields       String[]     @map("required_profile_fields")
  outputs                     String[]
  authorityScope              AuthorityScope   @default(PROBATE) @map("authority_scope")
  scope                       String       @default("CORE")
  allowedCounties             String[]     @map("allowed_counties")
  createdAt                   DateTime     @default(now()) @map("created_at")
  updatedAt                   DateTime     @updatedAt @map("updated_at")
  applicableStates            String[]     @map("applicable_states")
  phase                       RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, taskCode])
  @@map("roadmap_tasks")
}

model RoadmapTaskStateOverride {
  id                 String    @id @default(uuid())
  taskKey            String    @map("task_key")
  stateCode          String    @map("state_code")
  title              String?
  description        String?
  formNames          String[]  @map("form_names")
  primaryActionLabel String?   @map("primary_action_label")
  primaryActionUrl   String?   @map("primary_action_url")
  links              Json?
  sourceUrl          String?   @map("source_url")
  lastVerifiedAt     DateTime? @map("last_verified_at")
  reviewedBy         String?   @map("reviewed_by")
  changeLog          Json?     @map("change_log")
  confidence         String?   @default("draft")
  officialForms      Json?     @map("official_forms")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  isOptional         Boolean?  @map("is_optional")
  dependencies       String[]

  @@unique([stateCode, taskKey])
  @@map("roadmap_task_state_overrides")
}

model JurisdictionRule {
  id                   String   @id @default(uuid())
  stateCode            String   @unique @map("state_code")
  probateSystem        String   @default("GENERIC") @map("probate_system")
  smallEstateThreshold Decimal  @map("small_estate_threshold") @db.Decimal(12, 2)
  smallEstateTerm      String   @map("small_estate_term")
  claimWindowDays      Int      @default(365) @map("claim_window_days")
  shortenedWindowDays  Int?     @map("shortened_window_days")
  estateTaxThreshold   Decimal? @map("estate_tax_threshold") @db.Decimal(12, 2)
  bondDefaultRequired  Boolean  @default(true) @map("bond_default_required")
  bondWaiverRules      Json?    @map("bond_waiver_rules")
  citations            Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("jurisdiction_rules")
}


model Transaction {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("USD")
  status                String   @default("SUCCESS")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  type                  String   @default("PAYMENT")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model KnowledgeChunk {
  id        String   @id @default(uuid())
  content   String
  metadata  Json?
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("knowledge_chunks")
  @@ignore
}

model RagDocument {
  id            String     @id @default(uuid())
  sourceUri     String?
  title         String
  docType       DocType    @default(OTHER)
  jurisdiction  String?
  effectiveDate DateTime?
  version       String?
  ingestedAt    DateTime   @default(now())
  securityTags  String[]   @default([])
  chunks        RagChunk[]

  @@index([jurisdiction])
  @@index([docType])
  @@index([effectiveDate])
  @@map("rag_documents")
}

model RagChunk {
  id          String              @id @default(uuid())
  documentId  String              @map("document_id")
  parentId    String?             @map("parent_id")
  headingPath String?             @map("heading_path")
  sectionId   String?             @map("section_id")
  pageStart   Int?                @map("page_start")
  pageEnd     Int?                @map("page_end")
  text        String
  tokenCount  Int?                @map("token_count")
  contentHash String              @map("content_hash")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  embeddings  RagChunkEmbedding[]
  document    RagDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent      RagChunk?           @relation("ChunkParent", fields: [parentId], references: [id])
  children    RagChunk[]          @relation("ChunkParent")

  @@unique([documentId, contentHash])
  @@index([documentId])
  @@index([parentId])
  @@index([sectionId])
  @@map("rag_chunks")
}

model RagChunkEmbedding {
  id         String   @id @default(uuid())
  chunkId    String   @map("chunk_id")
  vectorType String   @default("content") @map("vector_type")
  modelId    String   @map("model_id")
  createdAt  DateTime @default(now()) @map("created_at")
  chunk      RagChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([vectorType, modelId])
  @@map("rag_chunk_embeddings")
}

model AgentExecution {
  id              String   @id @default(uuid())
  executionId     String   @unique @map("execution_id")
  userId          String?  @map("user_id")
  question        String
  answer          String
  sources         String[]
  evidence        Json
  metadata        Json
  executionTimeMs Int      @map("execution_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("agent_executions")
}

model MarketingEvent {
  id          String   @id @default(uuid())
  event       String
  email       String?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  source      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("marketing_events")
}

model AdvisorProfile {
  id                       String                   @id @default(uuid())
  userId                   String                   @unique @map("user_id")
  bio                      String?
  expertise                String[]
  hourlyRate               Decimal                  @map("hourly_rate") @db.Decimal(10, 2)
  stripeAccountId          String?                  @map("stripe_account_id")
  verificationStatus       String                   @default("PENDING") @map("verification_status")
  licenseNumber            String?                  @map("license_number")
  licenseDocument          String?                  @map("license_document")
  isVerified               Boolean                  @default(false) @map("is_verified")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  profileImage             String?                  @map("profile_image")
  stripeDetailsSubmitted   Boolean                  @default(false) @map("stripe_details_submitted")
  stripeOnboardingComplete Boolean                  @default(false) @map("stripe_onboarding_complete")
  advisorType              String                   @default("ATTORNEY") @map("advisor_type")
  avgRating                Float?                   @map("avg_rating")
  bufferMinutes            Int                      @default(15) @map("buffer_minutes")
  cancellationHours        Int                      @default(24) @map("cancellation_hours")
  languages                String[]                 @default(["English"])
  maxSessionsPerDay        Int                      @default(8) @map("max_sessions_per_day")
  meetingLink              String?                  @map("meeting_link")
  noShowPolicy             String?                  @map("no_show_policy")
  publicNotes              String?                  @map("public_notes")
  requiresApproval         Boolean                  @default(false) @map("requires_approval")
  specialties              String[]                 @default([])
  statesServed             String[]                 @default([]) @map("states_served")
  status                   AdvisorStatus            @default(DRAFT)
  timezone                 String                   @default("America/New_York")
  totalReviews             Int                      @default(0) @map("total_reviews")
  licenseDocuments         AdvisorLicenseDocument[]
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratePlans                AdvisorRatePlan[]
  availabilityExceptions   AvailabilityException[]
  availabilityRules        AvailabilityRule[]
  bookings                 Booking[]
  reviews                  Review[]

  @@index([status])
  @@index([hourlyRate], map: "idx_advisor_hourly_rate")
  @@index([avgRating(sort: Desc)], map: "idx_advisor_avg_rating")
  @@map("advisor_profiles")
}

model AdvisorLicenseDocument {
  id              String         @id @default(uuid())
  advisorId       String         @map("advisor_id")
  documentType    String         @map("document_type")
  storageKey      String         @map("storage_key")
  fileName        String         @map("file_name")
  mimeType        String         @map("mime_type")
  sizeBytes       Int            @default(0) @map("size_bytes")
  status          DocumentStatus @default(UPLOADED)
  licenseNumber   String?        @map("license_number")
  issuingState    String?        @map("issuing_state")
  expirationDate  DateTime?      @map("expiration_date")
  rejectionReason String?        @map("rejection_reason")
  verifiedAt      DateTime?      @map("verified_at")
  verifiedBy      String?        @map("verified_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  advisor         AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([advisorId])
  @@index([status])
  @@index([expirationDate], map: "idx_license_expiration")
  @@map("advisor_license_documents")
}

model AdvisorRatePlan {
  id              String         @id @default(uuid())
  advisorId       String         @map("advisor_id")
  serviceName     String         @map("service_name")
  durationMinutes Int            @map("duration_minutes")
  priceCents      Int            @map("price_cents")
  currency        String         @default("USD")
  description     String?
  isActive        Boolean        @default(true) @map("is_active")
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  advisor         AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([advisorId])
  @@map("advisor_rate_plans")
}

model AvailabilityRule {
  id        String         @id @default(uuid())
  advisorId String         @map("advisor_id")
  dayOfWeek Int            @map("day_of_week")
  startTime String         @map("start_time")
  endTime   String         @map("end_time")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([advisorId, dayOfWeek], map: "idx_avail_rule_advisor_day")
  @@map("availability_rules")
}

model AvailabilityException {
  id         String         @id @default(uuid())
  advisorId  String         @map("advisor_id")
  date       DateTime       @db.Date
  isBlackout Boolean        @default(true) @map("is_blackout")
  startTime  String?        @map("start_time")
  endTime    String?        @map("end_time")
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at")
  advisor    AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([advisorId, date], map: "idx_avail_exception_advisor_date")
  @@index([advisorId, date], map: "idx_avail_exception_advisor_date_b")
  @@map("availability_exceptions")
}

model Booking {
  id                    String              @id @default(uuid())
  userId                String              @map("user_id")
  advisorId             String              @map("advisor_id")
  estateId              String?             @map("estate_id")
  totalAmount           Decimal             @map("total_amount") @db.Decimal(10, 2)
  platformFee           Decimal             @map("platform_fee") @db.Decimal(10, 2)
  advisorPayout         Decimal             @map("advisor_payout") @db.Decimal(10, 2)
  escrowReleaseDate     DateTime?           @map("escrow_release_date")
  stripePaymentId       String?             @map("stripe_payment_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  cancellationReason    String?             @map("cancellation_reason")
  payoutStatus          String              @default("UNPAID") @map("payout_status")
  refundAmount          Decimal?            @map("refund_amount") @db.Decimal(10, 2)
  refundedAt            DateTime?           @map("refunded_at")
  sessionDate           DateTime?           @map("session_date")
  advisorNotes          String?             @map("advisor_notes")
  cancelledAt           DateTime?           @map("cancelled_at")
  cancelledBy           String?             @map("cancelled_by")
  currency              String              @default("USD")
  durationMinutes       Int                 @map("duration_minutes")
  endTime               DateTime            @map("end_time")
  idempotencyKey        String?             @unique @map("idempotency_key")
  intakeAnswers         Json?               @map("intake_answers")
  meetingLink           String?             @map("meeting_link")
  ratePlanId            String?             @map("rate_plan_id")
  sessionDuration       Int?                @map("session_duration")
  startTime             DateTime            @map("start_time")
  stripePaymentIntentId String?             @unique @map("stripe_payment_intent_id")
  timezone              String              @default("America/New_York")
  version               Int                 @default(0)
  status                BookingStatus       @default(REQUESTED)
  advisor               AdvisorProfile      @relation(fields: [advisorId], references: [id])
  estate                Estate?             @relation(fields: [estateId], references: [id])
  ratePlan              AdvisorRatePlan?    @relation(fields: [ratePlanId], references: [id])
  user                  User                @relation(fields: [userId], references: [id])
  dispute               Dispute?
  payment               MarketplacePayment?
  review                Review?

  @@index([userId], map: "idx_booking_user")
  @@index([advisorId], map: "idx_booking_advisor")
  @@index([status], map: "idx_booking_status")
  @@index([advisorId, startTime, endTime], map: "idx_booking_advisor_time")
  @@map("bookings")
}

model MarketplacePayment {
  id                    String        @id @default(uuid())
  bookingId             String        @unique @map("booking_id")
  userId                String        @map("user_id")
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  stripeChargeId        String?       @map("stripe_charge_id")
  amount                Int
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  capturedAt            DateTime?     @map("captured_at")
  refundedAmount        Int?          @map("refunded_amount")
  refundedAt            DateTime?     @map("refunded_at")
  stripeRefundId        String?       @map("stripe_refund_id")
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  booking               Booking       @relation(fields: [bookingId], references: [id])
  user                  User          @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@map("marketplace_payments")
}

model Dispute {
  id           String        @id @default(uuid())
  bookingId    String        @unique @map("booking_id")
  openedBy     String        @map("opened_by")
  reason       String
  description  String?
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedBy   String?       @map("resolved_by")
  resolvedAt   DateTime?     @map("resolved_at")
  refundAmount Int?          @map("refund_amount")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  booking      Booking       @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@map("disputes")
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId], map: "idx_audit_target")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created_at")
  @@map("admin_action_logs")
}

model Review {
  id        String         @id @default(uuid())
  bookingId String         @unique @map("booking_id")
  userId    String         @map("user_id")
  advisorId String         @map("advisor_id")
  rating    Int
  comment   String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [id])
  booking   Booking        @relation(fields: [bookingId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@index([advisorId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model LettersDispatch {
  id               String    @id @default(uuid())
  estateId         String    @map("estate_id")
  institutionName  String    @map("institution_name")
  institutionType  String    @map("institution_type")
  needsOriginal    Boolean   @default(false) @map("needs_original")
  status           String    @default("not_sent")
  sentAt           DateTime? @map("sent_at")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  followUpDueAt    DateTime? @map("follow_up_due_at")
  certifiedCopyRef String?   @map("certified_copy_ref")
  notes            String?
  isCustom         Boolean   @default(false) @map("is_custom")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  estate           Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId, status])
  @@index([estateId, followUpDueAt])
  @@map("letters_dispatches")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@map("token_blacklist")
}

enum DocType {
  STATUTE
  POLICY
  PLAYBOOK
  FAQ
  FORM
  BLOG
  OTHER
}

enum AdvisorStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
}

enum DocumentStatus {
  UPLOADED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_RELEASED
  CLOSED
}

enum UserRole {
  ADMIN
  ADVISOR
  ATTORNEY
  EXECUTOR
  HEIR
}

model CountyOverride {
  id              String   @id @default(uuid())
  stateCode       String   @map("state_code")
  countyName      String   @map("county_name")
  taskId          String   @map("task_id")
  
  // Whitelisted fields allowed for override
  title           String?
  description     String?
  feeAmount       Decimal? @map("fee_amount") @db.Decimal(12, 2)
  primaryActionUrl String?  @map("primary_action_url")
  formNames       String[] @map("form_names")
  attachments     Json?    // Array of { label: string, url: string }
  
  // Approval workflow
  status          String   @default("DRAFT") @map("status") // DRAFT | PENDING_REVIEW | APPROVED | REJECTED
  submittedBy     String?  @map("submitted_by")
  submittedAt     DateTime? @map("submitted_at")
  reviewedBy      String?  @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewNotes     String?  @map("review_notes")
  
  // Internal tracking
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  publishedAt     DateTime? @map("published_at")
  
  @@unique([stateCode, countyName, taskId])
  @@index([status])
  @@index([stateCode, status])
  @@map("county_overrides")
}

// Diagnostic Run - Stores jurisdiction health check results
model DiagnosticRun {
  id              String   @id @default(uuid())
  stateCode       String   @map("state_code")
  overallStatus   String   @map("overall_status") // PASS | FAIL
  healthScore     Int      @map("health_score")
  criticalCount   Int      @default(0) @map("critical_count")
  warningCount    Int      @default(0) @map("warning_count")
  infoCount       Int      @default(0) @map("info_count")
  resultsJson     Json     @map("results_json")
  triggeredBy     String   @map("triggered_by")
  commitSha       String?  @map("commit_sha")
  branchName      String?  @map("branch_name")
  durationMs      Int      @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@index([stateCode])
  @@index([stateCode, createdAt])
  @@index([overallStatus])
  @@map("diagnostic_runs")
}

// Authority Change Event - Audit trail for authority type changes
model AuthorityChangeEvent {
  id                String    @id @default(uuid())
  estateId          String    @map("estate_id")
  
  // Change tracking
  previousType      String?   @map("previous_type")
  newType           String    @map("new_type")
  changeSource      String    @map("change_source") // "ENGINE" | "MANUAL" | "REPIN" | "INITIAL_PIN"
  triggeredBy       String?   @map("triggered_by") // userId who triggered
  
  // Timing
  computedAt        DateTime  @map("computed_at") @default(now())
  appliedAt         DateTime? @map("applied_at")
  
  // Impact analysis
  diffSummary       Json?     @map("diff_summary") // { tasksAdded: [], tasksRemoved: [], affectedTasks: number }
  migrationNotes    String?   @map("migration_notes")
  
  // Revert tracking
  revertedAt        DateTime? @map("reverted_at")
  revertReason      String?   @map("revert_reason")
  
  // Relations
  estate            Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  
  @@index([estateId])
  @@index([estateId, computedAt])
  @@map("authority_change_events")
}

enum AuthorityScope {
  PROBATE
  TRUST
  BOTH
}
